# Server-only secrets — never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_DAILY_CAP=200
GEMINI_BURST_CAP=20

# JSON-RPC endpoints (Alchemy or equivalent)
SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BNB_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Rate-limit IP trust: set true behind your own reverse proxy that strips client XFF.
# On Vercel, x-vercel-forwarded-for is preferred automatically (VERCEL=1 also enables XFF).
# TRUSTED_PROXY=false

# Optional durable rate-limit + spend (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
